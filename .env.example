# ===== 임장지도 설정 =====
# 각 줄의 = 뒤에 발급받은 키를 붙여넣고 저장하세요. (따옴표·띄어쓰기 없이)

# [필수] 네이버 지도 Client ID — 네이버 클라우드 플랫폼 > Maps
NAVER_MAP_KEY_ID=

# [필수] 브이월드 인증키 — 공시지가·용도지역·필지경계
VWORLD_KEY=
VWORLD_DOMAIN=http://localhost:3000

# [필수] 공공데이터포털 일반 인증키(Decoding) — 실거래가·건축물대장
DATA_GO_KR_KEY=

# 네이버 부동산 매물 탭 (키 필요 없음, 비공식 방식). 끄려면 false
NAVER_LAND_ENABLED=true

PORT=3000
